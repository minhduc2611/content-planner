{
  "name": "content-planner",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch server/index.js & vite",
    "build": "vite build",
    "start": "node server/index.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "test": "node --test web/mix.test.js server/auth.test.js",
    "db:local": "docker start content-planner-pg 2>/dev/null || docker run -d --name content-planner-pg -e POSTGRES_PASSWORD=dev -e POSTGRES_DB=content_planner -p 5432:5432 postgres:17"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.10",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "prisma": "^7.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.8"
  }
}
