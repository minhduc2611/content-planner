# Local Postgres (npm run db:local). On Aiven, the Postgres integration sets DATABASE_URL for you.
DATABASE_URL="postgresql://postgres:dev@localhost:5432/content_planner"
# Optional: Aiven CA certificate (contents of ca.pem) so the TLS connection is fully verified
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----..."
# Comma-separated emails that become admin when they sign up / log in
ADMIN_EMAILS=""
PORT=3001
