generator client {
  provider = "prisma-client-js"
}

// Any Postgres works (Aiven, Supabase, Neon, local Docker): just change DATABASE_URL
datasource db {
  provider = "postgresql"
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String
  role         String    @default("user") // "user" | "admin"
  createdAt    DateTime  @default(now())
  sessions     Session[]
  projects     Project[]
}

model Session {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique // only a hash is stored, so a DB leak doesn't leak logins
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
}

model Project {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  niche     String
  // shortcut: lists stored as newline-separated text (same as the textareas); split into tables if items need their own fields
  subs      String
  formats   String
  angles    String
  createdAt DateTime  @default(now())
  contents  Content[]

  @@index([userId])
}

// One row per idea the user has touched (ticked or wrote notes for); keyed by text so editing inputs never loses them
model Content {
  id        Int      @id @default(autoincrement())
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sub       String
  format    String
  angle     String
  done      Boolean  @default(false)
  doc       String   @default("")
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([projectId, sub, format, angle])
}

// Shared library of formats and angles, curated by admins; projects reference them by name
model Guide {
  id          Int    @id @default(autoincrement())
  kind        String // "format" | "angle"
  name        String
  description String @default("")
  steps       String @default("") // one per line
  examples    String @default("") // one video link per line
  hooks       String @default("") // one per line
  position    Int    @default(0)

  @@unique([kind, name])
}
